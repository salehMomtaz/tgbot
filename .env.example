# =========================================================================
#  tgbot configuration — copy this file to ".env" and fill in your values.
#  Lines starting with # are comments. Only edit the lines without a # in front
#  of the key, or add the keys you need.
#
#  After editing, NEVER commit your real .env (it is git-ignored). .env.example
#  is the safe template that goes into git.
# =========================================================================

# -------------------------------------------------------------------------
# REQUIRED — get these from https://my.telegram.org (API development tools):
# -------------------------------------------------------------------------
# Your Telegram API ID (a number, e.g. 1234567). Leave 0 only to test that the
# file is being read — the bot will NOT run without a real value.
API_ID=0

# Your Telegram API Hash (a long string of letters and digits).
API_HASH=

# The token from @BotFather when you created your bot (e.g. 1234:ABCdef...).
BOT_TOKEN=

# -------------------------------------------------------------------------
# REQUIRED — your own numeric Telegram user ID.
#   How to get it: message @userinfobot (or @getmyid_bot) on Telegram; it replies
#   with your user ID. Only THIS user can open the Admin Console and use the bot.
# -------------------------------------------------------------------------
SYSTEM_CREATOR_ID=0


# =========================================================================
# REQUIRED — private log channel (the bot refuses to start without this)
# =========================================================================
# Create a PRIVATE channel, add your bot as an administrator (with "Post
# Messages" permission), then put the channel's numeric ID here. The bot
# streams its logs there in real time, and the system monitor (see below)
# sends its #system reports + resource warnings there too. To find the
# channel ID: forward a message from your channel to @userinfobot.
# This MUST be set — the bot will not start with LOG_CHANNEL_ID=0.
LOG_CHANNEL_ID=0


# =========================================================================
# OPTIONAL — 4 GB uploads via a Premium userbot session
# =========================================================================
# The bot API (BOT_TOKEN above) can upload up to 2 GB per file. If you have a
# Telegram Premium account, you can ALSO provide a user session string so the
# bot can upload files up to 4 GB. Generate it once with:
#     python generate_session.py
# Paste the printed string here. Leave empty to use the normal 2 GB bot limit.
#
# NOTE: Bots themselves are hard-capped at 2 GB by Telegram — a 4 GB upload can
# only be sent by a Premium *user* account over MTProto. The bot uses this
# session as an uploader userbot; it is never exposed as an interactive client.
#
# With a session set, the 4 GB path is granted per user from the Admin Console
# (Admin → 👑 Premium Uploads). Only whitelisted users (plus the creator) get
# 4 GB uploads; everyone else stays at 2 GB even though the userbot exists.
PREMIUM_STRING_SESSION=


# =========================================================================
# OPTIONAL — direct-link / streaming server (FastAPI on port 8080)
# =========================================================================
# The bot can hand out direct download/stream links for files you forward to it.
# This is the public base URL those links use.
#   • Behind Nginx with HTTPS:  https://yourdomain.com/tgbot
#   • Direct (no domain):       http://YOUR_VPS_IP:8080
DOMAIN=http://YOUR_VPS_IP:8080

# If you have SSL certificates and want native HTTPS on port 8443/8080, set both
# paths. Leave both empty to run the stream server over plain HTTP.
SSL_CERT_PATH=
SSL_KEY_PATH=


# =========================================================================
# OPTIONAL — proxy (only for VPS in regions where YouTube/X/Insta/TikTok are
# blocked). On a normal foreign VPS, LEAVE ALL OF THESE UNSET.
# =========================================================================
# Any one of these is enough; the bot picks the first one it finds:
#   SOCKS5_PROXY=socks5://127.0.0.1:10808
#   ALL_PROXY=socks5://127.0.0.1:10808
#   HTTP_PROXY=http://127.0.0.1:10809
#   HTTPS_PROXY=http://127.0.0.1:10809

# Custom User-Agent sent to YouTube by yt-dlp. Usually leave empty.
YTDLP_USER_AGENT=


# =========================================================================
# PO-token provider (YouTube proof-of-origin) — normally LEAVE THESE DEFAULTS.
# =========================================================================
# YouTube now requires a proof-of-origin (PO) token. The provider is ALWAYS ON by
# default and is installed + started automatically by ./install.sh. YouTube
# downloads use cookies + PO token with NO fallback. Set to false ONLY if you
# want to disable YouTube support entirely.
YTDLP_POT_ENABLED=true

# Port the local provider listens on (127.0.0.1 only — never exposed to the net).
YTDLP_POT_PORT=4416

# Where install.sh cloned the provider source (relative to the project dir).
YTDLP_POT_PROVIDER_PATH=bgutil-provider/server

# Pinned bgutil git ref. Bump deliberately to upgrade the provider.
YTDLP_POT_PROVIDER_REF=1.3.1

# Deno binary name/path. install.sh installs Deno to ~/.deno/bin; "deno" works
# once it is on PATH (run.sh and the bot add it automatically).
YTDLP_POT_DENO_BIN=deno

# YouTube player client used during extraction.
YTDLP_POT_PLAYER_CLIENT=mweb

# ---------------------------------------------------------------------------
# Playlist downloads
# ---------------------------------------------------------------------------
# Maximum number of videos downloaded from a single YouTube playlist. Caps a
# 1,000-video list from hammering the VPS; the bot sends the first N and warns
# the user. Raise it if you routinely download large playlists.
PLAYLIST_MAX_VIDEOS=50

# ---------------------------------------------------------------------------
# Cookie lifecycle — LEAVE THESE DEFAULTS unless you know why.
# ---------------------------------------------------------------------------
# After every successful authenticated yt-dlp run, rotated session cookies are
# merged back into the real jar. This is what KEEPS YOUR INSTAGRAM SESSION
# ALIVE: Instagram continually rotates sessionid/csrftoken; discarding the
# rotations is what made jars go stale before. Keep this true.
COOKIE_WRITEBACK_ENABLED=true
# Warn (log channel) when a jar had no successful authenticated run in N days.
COOKIE_STALE_WARNING_DAYS=21

# =========================================================================
# OPTIONAL — Direct-forward (Instagram / X DM relay)
# =========================================================================
# You DM a post / reel / story / photo / video (or paste a plain link) from
# YOUR personal account to the BOT's dedicated account inside Instagram or X.
# The bot polls its own DM inbox and delivers the media to your Telegram chat.
# Supports photos, videos, reels, story shares, and tweet shares. No
# third-party APIs — it logs in as the bot account directly (see
# docs/DIRECT_FORWARD_SETUP.md).

# Telegram chat ID where forwarded media lands. Use your own numeric user ID.
DIRECT_FORWARD_CHAT_ID=0

# How often each platform inbox is polled, in seconds. Default 300.
# Instagram flags machine-paced polling — keep this at several minutes, not seconds.
DIRECT_FORWARD_POLL_SECONDS=300
# Randomize each interval by ±this percent (0 = fixed cadence). Default 40.
DIRECT_FORWARD_POLL_JITTER_PCT=40
# Optional dedicated proxy for the DM sessions (one STABLE residential proxy
# per account is far safer than a datacenter IP; per-request rotation gets
# accounts flagged). http://user:pass@host:port or socks5h://host:port
DIRECT_FORWARD_PROXY=

# --- Instagram ---
# Preferred auth is automatic: the DM client bootstraps from the sessionid in
# your igcookies.txt jar (upload it via Admin → Cookies). Username/password is
# only a fallback for when that session is dead.
IG_DIRECT_ENABLED=false
IG_DIRECT_USERNAME=
IG_DIRECT_PASSWORD=
IG_DIRECT_TOTP_SEED=
# YOUR personal Instagram handle — acts as a STATIC pre-pair (resolved to your
# numeric user id once). The safer option is the interactive handshake:
# Admin Console → 📨 Direct-Forward → 🔗 Pair Instagram → send the code to the
# bot's account via Instagram DM. Only the paired contact is ever relayed.
IG_DIRECT_FROM_USERNAME=

# --- Instagram anti-detection (optional) ---
# The IG DM client previously drove the private API with a plain Python
# requests TLS fingerprint — an easy "this is a script" signal. These knobs
# pin the session to a real Chrome fingerprint and to the account's home
# region. Leave them at defaults unless you know why you're changing them.
# chrome136 is the safest impersonation target; any curl_cffi BrowserType
# literal works (chrome142, safari18_0, ...).
IG_DIRECT_TRANSPORT_IMPERSONATE=chrome136
# Geo pinning: MUST match the account's real home region + the proxy's region.
IG_DIRECT_COUNTRY=US
IG_DIRECT_COUNTRY_CODE=1
IG_DIRECT_LOCALE=en_US
IG_DIRECT_TZ_OFFSET=-14400
IG_DIRECT_TZ_NAME=GMT-04:00

# --- X / Twitter ---
# twikit logs in with username/password (+email) once and persists cookies to
# direct_x_cookies.json. X aggressively challenges fresh automation logins; if
# login fails, warm the account (see docs/DIRECT_FORWARD_SETUP.md).
X_DIRECT_ENABLED=false
X_DIRECT_USERNAME=
X_DIRECT_PASSWORD=
X_DIRECT_EMAIL=
# YOUR numeric X user id (e.g. from https://x.com/yourhandle → view-source, or
# an id-lookup bot). Only DMs from this user id are relayed. OPTIONAL since the
# 2026-08-08 pairing: Admin Console → Direct-Forward → 🔗 Pair X/Twitter issues
# a one-time code you DM to the bot account — the worker binds your numeric id
# automatically. This env var remains the static pre-pair / fallback.
X_DIRECT_FROM_USER_ID=

# =========================================================================
# OPTIONAL — System monitor (lightweight, bot-independent)
# =========================================================================
# A tiny /proc-based watcher (utils/system_monitor.py) that posts CPU / RAM /
# swap / disk usage, load averages, and the top processes to the log channel,
# and warns when CPU/RAM/disk exceed a threshold. It runs as its OWN process
# (tgbot-monitor.service), so it keeps watching even if the bot crashes.
#
# Sample cadence in seconds (15s default). Keep this >= 5 to stay negligible.
SYSMON_POLL_SECONDS=15
# Full "#system" report every N samples (60 * 15s = every 15 minutes).
SYSMON_REPORT_INTERVAL=60
# Warning threshold (%) for CPU / RAM / disk. While ANY metric is above this,
# a warning is sent every SYSMON_WARN_SECONDS until everything drops below.
SYSMON_WARN_PCT=80
SYSMON_WARN_SECONDS=60
# Top-N processes by CPU and by RAM shown in each report.
SYSMON_TOP_N=20
# Samples kept for time-frame averages (240 * 15s = 1 hour of history).
SYSMON_HISTORY_SAMPLES=240
# Comma-separated filesystem paths to report on. "." = the bot's working dir.
SYSMON_DISK_PATHS=.

