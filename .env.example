# =========================================================================
#  tgbot configuration — copy this file to ".env" and fill in your values.
#  Lines starting with # are comments. Only edit the lines without a # in front
#  of the key, or add the keys you need.
#
#  After editing, NEVER commit your real .env (it is git-ignored). .env.example
#  is the safe template that goes into git.
# =========================================================================

# -------------------------------------------------------------------------
# REQUIRED — get these from https://my.telegram.org (API development tools):
# -------------------------------------------------------------------------
# Your Telegram API ID (a number, e.g. 1234567). Leave 0 only to test that the
# file is being read — the bot will NOT run without a real value.
API_ID=0

# Your Telegram API Hash (a long string of letters and digits).
API_HASH=

# The token from @BotFather when you created your bot (e.g. 1234:ABCdef...).
BOT_TOKEN=

# -------------------------------------------------------------------------
# REQUIRED — your own numeric Telegram user ID.
#   How to get it: message @userinfobot (or @getmyid_bot) on Telegram; it replies
#   with your user ID. Only THIS user can open the Admin Console and use the bot.
# -------------------------------------------------------------------------
SYSTEM_CREATOR_ID=0


# =========================================================================
# OPTIONAL — log channel (recommended but not required)
# =========================================================================
# Create a PRIVATE channel, add your bot as an administrator (with "Post
# Messages" permission), then put the channel's numeric ID here. The bot will
# stream its logs there in real time. To find the channel ID: forward a message
# from your channel to @userinfobot. Leave 0 if you don't want channel logging
# (logs are also written to logs/bot.log on the VPS).
LOG_CHANNEL_ID=0


# =========================================================================
# OPTIONAL — 4 GB uploads via a Premium userbot session
# =========================================================================
# The bot API (BOT_TOKEN above) can upload up to 2 GB per file. If you have a
# Telegram Premium account, you can ALSO provide a user session string so the
# bot can upload files up to 4 GB. Generate it once with:
#     python generate_session.py
# Paste the printed string here. Leave empty to use the normal 2 GB bot limit.
PREMIUM_STRING_SESSION=


# =========================================================================
# OPTIONAL — direct-link / streaming server (FastAPI on port 8080)
# =========================================================================
# The bot can hand out direct download/stream links for files you forward to it.
# This is the public base URL those links use.
#   • Behind Nginx with HTTPS:  https://yourdomain.com/tgbot
#   • Direct (no domain):       http://YOUR_VPS_IP:8080
DOMAIN=http://YOUR_VPS_IP:8080

# If you have SSL certificates and want native HTTPS on port 8443/8080, set both
# paths. Leave both empty to run the stream server over plain HTTP.
SSL_CERT_PATH=
SSL_KEY_PATH=


# =========================================================================
# OPTIONAL — proxy (only for VPS in regions where YouTube/X/Insta/TikTok are
# blocked). On a normal foreign VPS, LEAVE ALL OF THESE UNSET.
# =========================================================================
# Any one of these is enough; the bot picks the first one it finds:
#   SOCKS5_PROXY=socks5://127.0.0.1:10808
#   ALL_PROXY=socks5://127.0.0.1:10808
#   HTTP_PROXY=http://127.0.0.1:10809
#   HTTPS_PROXY=http://127.0.0.1:10809

# Custom User-Agent sent to YouTube by yt-dlp. Usually leave empty.
YTDLP_USER_AGENT=


# =========================================================================
# PO-token provider (YouTube proof-of-origin) — normally LEAVE THESE DEFAULTS.
# =========================================================================
# YouTube now requires a proof-of-origin (PO) token. The provider is ALWAYS ON by
# default and is installed + started automatically by ./install.sh. YouTube
# downloads use cookies + PO token with NO fallback. Set to false ONLY if you
# want to disable YouTube support entirely.
YTDLP_POT_ENABLED=true

# Port the local provider listens on (127.0.0.1 only — never exposed to the net).
YTDLP_POT_PORT=4416

# Where install.sh cloned the provider source (relative to the project dir).
YTDLP_POT_PROVIDER_PATH=bgutil-provider/server

# Pinned bgutil git ref. Bump deliberately to upgrade the provider.
YTDLP_POT_PROVIDER_REF=1.3.1

# Deno binary name/path. install.sh installs Deno to ~/.deno/bin; "deno" works
# once it is on PATH (run.sh and the bot add it automatically).
YTDLP_POT_DENO_BIN=deno

# YouTube player client used during extraction.
YTDLP_POT_PLAYER_CLIENT=mweb

# ---------------------------------------------------------------------------
# Playlist downloads
# ---------------------------------------------------------------------------
# Maximum number of videos downloaded from a single YouTube playlist. Caps a
# 1,000-video list from hammering the VPS; the bot sends the first N and warns
# the user. Raise it if you routinely download large playlists.
PLAYLIST_MAX_VIDEOS=50


# =========================================================================
# OPTIONAL — Auto-forward (Instagram / TikTok / X account relay)
# =========================================================================
# When you see a post in Instagram / TikTok / X, just share it (or "like" / "save")
# to your dedicated bot account on that platform. The bot polls the public
# "saved" / "liked" feeds of those accounts every poll seconds and forwards
# anything new to your Telegram chat. Works for photo + video posts.

# Telegram chat ID where auto-forwarded media lands. Use your own numeric user ID.
AUTO_FORWARD_CHAT_ID=0

# How often the bot polls each platform, in seconds. Default 300 (5 minutes).
AUTO_FORWARD_POLL_SECONDS=300

# Max items fetched per platform per poll. Caps a runaway pull.
AUTO_FORWARD_MAX_ITEMS=10

# Instagram relay
IG_AUTO_FORWARD_ENABLED=false
IG_AUTO_FORWARD_USERNAME=

# TikTok relay
TT_AUTO_FORWARD_ENABLED=false
TT_AUTO_FORWARD_USERNAME=

# X / Twitter relay (the user whose LIKES to poll — that is how posts flow in)
X_AUTO_FORWARD_ENABLED=false
X_AUTO_FORWARD_USERNAME=

