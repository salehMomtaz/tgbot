# Secrets & runtime config
.env
.env.local

# Cookie jars (contain private session cookies once populated)
ytcookies.txt
ytcookies.backup
igcookies.txt
ttcookies.txt
xcookies.txt
cookies.txt
# Auto-backups written by the admin-console cookie Replace (private cookies)
*.autobak

# Database
database.json

# pyrogram session files
*.session
*.session-journal

# Python
__pycache__/
*.pyc
venv/

# Go build output — produced by install.sh into build/tgbot-monitor
build/

# Runtime data
cache/
logs/
*.log
system_monitor.pid

# PO-token provider — cloned by install.sh (~200 MB, not part of this repo)
bgutil-provider/

# Machine-specific install record written by install.sh, read by uninstall.sh
tools/install-manifest.txt

# Cookie jars under the layout (private session cookies)
cookies/youtube/
cookies/instagram/
cookies/tiktok/
cookies/twitter/
cookies/meta.json
cookies/*.txt
# Cookie history tracker (fingerprints only, but jar snapshots are FULL jars —
# they contain real session cookies and must never be committed)
cookies/history.jsonl
cookies/history.jsonl.1
cookies/history_snapshots/
# Per-site jars under cookies/ytdlp/ were scaffolded as empty templates but are
# now ignored — an admin Replace writes REAL session cookies to these exact
# paths, and tracked files would leak them into the public repo on next commit.
cookies/ytdlp/*.txt
# Direct-forward client sessions (contain logged-in tokens)
direct_ig_session.json
direct_x_cookies.json
direct_forward_state.json

# OpenCode session export in markdown
session-ses_*.md

# OpenCode runtime state (session memory transcripts may contain secrets)
.opencode/memory/
.opencode/node_modules/
.opencode/package-lock.json
.opencode/package.json

# XChat bridge (emusks npm package + runtime state; the PIN lives in .env)
node_modules/
package-lock.json
cache/xchat_inbox.jsonl
cache/xchat_bridge_state.json

# Telethon operator session (logged-in user token for agent-side interaction)
telethon_session.txt

# Locally-cloned Instagram anti-detection reference repos (research only,
# intentionally NOT tracked — clone them with `git clone` into reference/)
# NOTE: anchored to repo root so docs/reference/ (tracked knowledge base) is not ignored
/reference/
certs/

# Mimocode scheduler runtime (ephemeral lock + cron state)
.mimocode/

# Removed Admin WebApp (2026-08-26) — do not re-add without explicit ask
modules/admin_webapp/
