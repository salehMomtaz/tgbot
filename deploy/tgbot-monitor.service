# tgbot-monitor.service — systemd unit TEMPLATE for the standalone system monitor.
#
# This file is a TEMPLATE. `./install.sh` copies it to /etc/systemd/system/
# and substitutes the real values for __USER__, __GROUP__, and __PROJECT_DIR__
# based on the user that ran install.sh. You do NOT need to edit it by hand.
#
# The monitor is a STATIC GO BINARY built by install.sh into
# __PROJECT_DIR__/build/tgbot-monitor (source: cmd/tgbot-monitor/) — see
# docs/go-feasibility.md for the port rationale. It reads /proc and posts to
# Telegram via the raw Bot HTTP API, so it needs no venv, no interpreter, and
# no dependency on pyrogram or the bot's event loop.
#
# WHY A SEPARATE UNIT (not a task inside tgbot.service):
#   The monitor reports system health to the log channel even when the bot is
#   down. If it lived inside the bot process, a bot crash would take the
#   monitor down with it — the exact failure mode we're trying to observe.
#   A separate unit keeps it alive independently of the bot.
#
#   main.py also tries to spawn a detached monitor on bot startup
#   (utils/system_monitor.py::spawn_detached_monitor, deduped against this
#   unit via the pidfile the binary writes), so even a tmux install gets a
#   monitor. systemd simply guarantees it survives reboot too.
#
# Resources: the monitor is a few MB RSS and a fraction of a percent of a core
# at 15s sampling. MemoryMax=256M is generous headroom, not a real working-set
# cap (and never use `ulimit -v` — see AGENTS.md invariant #1).
#
# HOW TO INSTALL + ENABLE (done for you by ./install.sh):
#   sudo systemctl enable --now tgbot-monitor
#   sudo journalctl -u tgbot-monitor -f     # live monitor log
#   tail -f logs/system_monitor.log          # its own timestamped log

[Unit]
Description=Telegram downloader bot — standalone system monitor
Documentation=https://github.com/salehMomtaz/tgbot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__USER__
Group=__GROUP__
WorkingDirectory=__PROJECT_DIR__
ExecStart=__PROJECT_DIR__/build/tgbot-monitor

# The monitor must keep running independently of the bot.
Restart=always
RestartSec=10

# A few MB working set; this is headroom, not a tight cap.
MemoryMax=256M

# Logs go to journald (journalctl -u tgbot-monitor). The binary prints its
# startup/sample lines to stdout, which lands here.
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
